# Copy this file to .env and uncomment what you want to change. The values shown are the defaults.
#   macOS/Linux:  cp .env.example .env      PowerShell: Copy-Item .env.example .env      cmd: copy .env.example .env
# Both `npm start` and `docker compose` / `podman-compose` read .env. Variables set in your shell win over .env.

# --- data
# RESET_ON_START=true           # true = fresh seed data on every start; false = keep your changes

# --- users (hardcoded defaults)
# ADMIN_USERNAME=admin          # can read and write
# ADMIN_PASSWORD=admin123
# VIEWER_USERNAME=viewer        # read-only: every write returns 403
# VIEWER_PASSWORD=viewer123
# TOKEN_TTL_SECONDS=86400       # token lifetime; try 30 to practise 401 TOKEN_EXPIRED

# --- teaching knobs (only affect /cards and /decks)
# LATENCY_MS=0                  # extra delay per request in ms; try 2000 for timeout lessons
# CHAOS_RATE=0                  # 0..1 share of successful requests that fail with 500; try 0.3 for retry lessons
# TEACHING_HEADERS=true         # allow the X-Delay-Ms / X-Chaos-Fail-Times / X-Chaos-Key request headers

# --- misc
# LOG_REQUESTS=true             # one log line per request
# CORS_ORIGIN=*                 # browser origins allowed to call the API (* or a comma-separated list)

# --- npm start only (inside the container the port and database file are fixed)
# PORT=3000
# DB_FILE=data/tcg.db

# --- docker compose / podman-compose only
# HOST_PORT=3000                # port on YOUR computer: http://localhost:<HOST_PORT>
# NODE_VERSION=24               # Node major of the image: 22, 24 or 26
