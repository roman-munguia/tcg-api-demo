{
  // Only for editor IntelliSense: Playwright compiles the TypeScript itself.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts", "data/**/*.ts", "endpoints/**/*.ts", "services/**/*.ts", "tests/**/*.ts", "types/**/*.ts"]
}
